{
  "$schema": "appsettings-schema.json",
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=(LocalDB)\\MSSQLLocalDB;Integrated Security=true;AttachDbFilename=C:\\Users\\League\\Documents\\Work\\Other\\Repos\\MinxLuxuryHair\\Umbraco\\Data\\MinxLuxuryHair.mdf;TrustServerCertificate=True;"
  },
  "Serilog": {
