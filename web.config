<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.webServer>
		<!-- Tell IIS to pass control to Kestrel -->
		<handlers>
			<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
		</handlers>
		<aspNetCore processPath="dotnet" arguments=".\MinxLuxuryHair.dll" stdoutLogEnabled="false" hostingModel="inprocess" stdoutLogFile=".\logs\stdout" />
		<!-- Redirect rules -->
		<rewrite>
			<rules>
				<!-- Force HTTPS -->
				<rule name="Redirect to HTTPS" enabled="true" stopProcessing="true">
					<match url="(.*)" ignoreCase="true" />
					<conditions>
						<add input="{HTTPS}" pattern="off" ignoreCase="true" />
					</conditions>
					<action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
				</rule>
				<!-- Remove www -->
				<rule name="Remove www" enabled="true" stopProcessing="true">
					<match url="(.*)" ignoreCase="true" />
					<conditions>
						<add input="{HTTP_HOST}" pattern="^www\.(.+)$" ignoreCase="true" />
					</conditions>
					<action type="Redirect" url="https://{C:1}/{R:1}" redirectType="Permanent" />
				</rule>
			</rules>
		</rewrite>
		<!-- Optional: gzip/deflate compression -->
		<urlCompression doStaticCompression="true" doDynamicCompression="true" />
		<httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files" />
		<directoryBrowse enabled="false" />
		<defaultDocument>
			<files>
				<clear />
				<add value="index.php" />
				<add value="Default.htm" />
				<add value="Default.asp" />
				<add value="index.htm" />
				<add value="index.html" />
				<add value="iisstart.htm" />
				<add value="default.aspx" />
			</files>
		</defaultDocument>
		<httpErrors errorMode="Detailed" existingResponse="PassThrough" />
		<modules>
			<remove name="Helicon.Ape" />
		</modules>
	</system.webServer>
</configuration>
