@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Core.Web
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;

@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    var footerContent = Umbraco.ContentAtRoot().FirstOrDefault(x => x.ContentType.Alias == "website");
    var logo = footerContent?.Value<IPublishedContent>("logo");
    var links = footerContent?.Value<IEnumerable<Link>>("links");

    var currentPage = Umbraco.AssignedContentItem;
    var pageSpacer = !String.IsNullOrEmpty(currentPage?.Value<string>("pageSpacer")) ? currentPage?.Value<string>("pageSpacer") : "100";
}

<div class="spacer-@pageSpacer">
    <footer>
        <div class="container">
            <div class = "row">
                <div class="col">
                    @if (logo != null)
                    {
                        <div class="logo">
                            <img src="@logo.Url()" alt="Minx Luxury Hair" />
                        </div>
                    }
                    <div class="footer-links">
                        @if (links?.Any() == true)
                        {
                            foreach (var link in links)
                            {
                                <a href="@link?.Url"
                                   target="@link?.Target">
                                    @link?.Name
                                </a>
                            }
                        }
                    </div>
                    <div class="copyright">
                        &copy; @DateTime.Now.Year - Minx Luxury Hair. All rights reserved.
                    </div>
                </div>
            </div>
        </div>
    </footer>
</div>